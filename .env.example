# Copia a .env y ajusta. docker compose lo lee automáticamente.

# --- Ollama (nativo en el host en macOS por acceso a Metal) ---
RAG_OLLAMA_HOST=http://host.docker.internal:11434
# Nativo (sin Docker): RAG_OLLAMA_HOST=http://localhost:11434

# --- Modelos locales (Mac Mini M4 16GB) ---
# LLM: Qwen3 4B — buen español, tool-use y razonamiento, ~2.6GB cuantizado
RAG_LLM_MODEL=qwen3:4b
# Embeddings: BGE-M3 — multilingüe (español), 1024 dims, ~1.2GB
RAG_EMBEDDING_MODEL=bge-m3

# --- Índice ---
RAG_COLLECTION=sein_contracts
# Carpeta con los .md que produce ocr_pdf_markdown (vault Obsidian/Osinergmin)
VAULT_DIR=./data/vault

# --- Seguridad (OBLIGATORIO si expones la app a internet) ---
# Vacío = sin autenticación (solo LAN). Genera una: openssl rand -hex 24
RAG_API_KEY=

# --- Frontend ---
FRONTEND_PORT=8080

# --- Exposición pública (docker compose --profile public) ---
# Token del túnel: Cloudflare Zero Trust → Networks → Tunnels → tu túnel
CLOUDFLARE_TUNNEL_TOKEN=

# --- Observabilidad ---
RAG_LOG_LEVEL=INFO
