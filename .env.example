# Copia a .env y ajusta. docker compose lo lee automáticamente.

# --- Ollama (nativo en el host en macOS por acceso a Metal) ---
RAG_OLLAMA_HOST=http://host.docker.internal:11434
# Nativo (sin Docker): RAG_OLLAMA_HOST=http://localhost:11434

# --- Modelos locales (Mac Mini M4 16GB) ---
# LLM: Qwen3 4B — buen español, tool-use y razonamiento, ~2.6GB cuantizado
RAG_LLM_MODEL=qwen3:4b
# Embeddings: BGE-M3 — multilingüe (español), 1024 dims, ~1.2GB
RAG_EMBEDDING_MODEL=bge-m3

# --- Índice ---
RAG_COLLECTION=sein_contracts
# Carpeta con los .md que produce ocr_pdf_markdown (vault Obsidian/Osinergmin)
VAULT_DIR=./data/vault

# --- Seguridad ---
# El backend NO arranca sin una de estas dos cosas. Genera la clave con:
#   openssl rand -hex 24
RAG_API_KEY=
# Ponlo en true SOLO si de verdad quieres la API abierta sin autenticación
# (p. ej. una LAN de confianza). Es deliberadamente incómodo: antes el valor
# vacío desactivaba la auth en silencio, y una exposición pública publicaba
# /api/documents —con RUC de usuarios libres— a todo internet.
RAG_ALLOW_ANONYMOUS=false

# Orígenes permitidos por CORS, separados por coma. Vacío = mismo origen
# (nginx sirve el front y la API juntos, que es el despliegue normal).
# Nunca uses "*" junto con RAG_API_KEY.
RAG_CORS_ORIGINS=

# --- Frontend ---
FRONTEND_PORT=8080
# Interfaz donde se publica nginx. Por defecto solo loopback: si lo abres a
# la LAN, cualquiera en la red alcanza /api/ sin pasar por el túnel.
FRONTEND_BIND=127.0.0.1

# --- Límites de recursos (el Mac Mini corre además Ollama y el OCR) ---
QDRANT_MEM_LIMIT=3g
BACKEND_MEM_LIMIT=1g
FRONTEND_MEM_LIMIT=256m

# --- Exposición pública (docker compose --profile public) ---
# Token del túnel: Cloudflare Zero Trust → Networks → Tunnels → tu túnel
CLOUDFLARE_TUNNEL_TOKEN=

# --- Observabilidad ---
RAG_LOG_LEVEL=INFO
